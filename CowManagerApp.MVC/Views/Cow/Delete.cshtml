@model CowManager.Models.Models.Cow

@{
    ViewData["Title"] = "Delete";
}

<div class="container">
    <h2>Delete</h2>
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Id</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Herd Id</dt>
                <dd class="col-sm-8">@Model.Idherd</dd>

                <dt class="col-sm-4">Name</dt>
