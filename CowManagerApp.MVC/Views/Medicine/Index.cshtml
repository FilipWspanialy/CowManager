@model IEnumerable<CowManager.Models.Models.Medicine>
@{
    ViewData["Title"] = "List";
}
<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Name
            </th>


        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Id
                </td>
                <td>
                    @item.Name
                </td>

                <td>
                    <a asp-action="MedicineDetails" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>

        }
    </tbody>
</table>
