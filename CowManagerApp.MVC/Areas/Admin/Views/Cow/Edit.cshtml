<link rel="stylesheet" href="~/css/Create.css" asp-append-version="true" />
@model CowManager.Models.Models.Cow

@{
    ViewData["Title"] = "Edit";
}

<style>
    .edit-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        background-color: #f0f0f0;
        padding: 20px;
        border-radius: 10px;
        color: #000;
    }

    .edit-grid-item {
        background-color: #ffffff;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 15px;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
    }

    .form-group label {
        font-weight: bold;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .btn {
        margin-right: 10px;
    }
</style>

<h1 style="color: black;">Edit Cow</h1>

@if (User.IsInRole("Admin"))
{
        <div class="edit-grid">
            <div class="edit-grid-item">
                <form asp-controller="Cow" asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group">
                        <label asp-for="Cowid" class="control-label">Id</label>
                        <input asp-for="Cowid" class="form-control" />
                        <span asp-validation-for="Cowid" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Idherd" class="control-label">Choose the herd</label>
                            <a asp-action="CreateHerd" class="btn btn-primary">Create Herd</a>
                        <select asp-for="Idherd" class="form-control" asp-items="ViewBag.Herds"></select>
                        <span asp-validation-for="Idherd" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Comment" class="control-label"></label>
                        <input asp-for="Comment" class="form-control" />
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="BirthDate">Birth date</label>
                        <input type="date" class="form-control" id="BirthDate" name="BirthDate" value="@(Model != null && Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>

                    <div class="form-group">
                        <label for="DeathDate">Death date</label>
                        <input type="date" class="form-control" id="DeathDate" name="DeathDate" value="@(Model != null && Model.DeathDate.HasValue ? Model.DeathDate.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>

                    <div class="form-group">
                        <label asp-for="UserId" class="control-label">Assign to User</label>
                        <select asp-for="UserId" class="form-control" asp-items="ViewBag.Users"></select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>

                    <input type="hidden" name="previousUrl" value="@ViewBag.PreviousUrl" />

                    <div class="form-group">
                        <input type="submit" value="Save" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>

        <div class="form-group">
            <a href="@ViewBag.PreviousUrl" class="btn btn-primary">Return</a>
        </div>
}
else
{
        <h2>You don't have access to this</h2>
        <div class="edit-grid">
            <div class="edit-grid-item">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" name="previousUrl" value="@ViewBag.PreviousUrl" />

                    <div class="form-group">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Idherd" class="control-label"></label>
                        <select asp-for="Idherd" class="form-control" asp-items="ViewBag.Herds"></select>
                        <span asp-validation-for="Idherd" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Comment" class="control-label"></label>
                        <input asp-for="Comment" class="form-control" />
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>
                </form>
            </div>
        </div>

        <div class="form-group">
            <a href="@ViewBag.PreviousUrl" class="btn btn-primary">Return</a>
        </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}