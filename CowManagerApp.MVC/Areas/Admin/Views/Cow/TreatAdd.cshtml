<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.CowTreatAdd

<style>
    .form-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card {
        margin-bottom: 20px;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #007bff;
        color: white;
        font-weight: bold;
        padding: 15px;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .card-body {
        padding: 20px;
    }

    .card-footer {
        background-color: #f8f9fa;
        padding: 10px;
        text-align: right;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    .form-group label {
        font-weight: bold;
    }

    .text-danger {
        color: #dc3545;
    }

    .btn {
        margin-right: 10px;
    }

    .no-access {
        text-align: center;
        font-size: 18px;
    }
</style>

<div class="form-container">
    <div class="card">
        <div class="card-header">
            Add Treatment for @Model.CowName
        </div>
        <div class="card-body">
            <a asp-action="Treat" asp-route-id="@Model.CowId" class="btn btn-secondary">Back to treatments</a>

            @if (User.IsInRole("Admin"))
            {
                    <form asp-action="TreatAdd" asp-controller="Cow" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="CowId" value="@Model.CowId" />
                        <input type="hidden" asp-for="CowName" value="@Model.CowName" />

                        <div class="form-group">
                            <label asp-for="SelectedMedicinetId" class="control-label">Medicine</label>
                            <a asp-controller="Medicine" asp-action="MedicineCreate" class="btn btn-link">Add medicine</a>
                            <select asp-for="SelectedMedicinetId" class="form-control" asp-items="@(new SelectList(Model.Medicines, "Id", "Name"))">
                                <option value="">Select medicine</option>
                            </select>
                            <span asp-validation-for="SelectedMedicinetId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Comment" class="control-label">Comment</label>
                            <textarea asp-for="Comment" class="form-control"></textarea>
                            <span asp-validation-for="Comment" class="text-danger"></span>
                        </div>

                        <div class="card-footer">
                            <input type="submit" value="Add treatment" class="btn btn-primary" />
                        </div>
                    </form>
            }
            else
            {
                    <p class="no-access text-danger">
                        You don't have access to Create ;(
                    </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}