<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.CowDiagAdd

<style>
    .form-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card {
        margin-bottom: 20px;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #007bff;
        color: white;
        font-weight: bold;
        padding: 15px;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .card-body {
        padding: 20px;
    }

    .card-footer {
        background-color: #f8f9fa;
        padding: 10px;
        text-align: right;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    .form-group label {
        font-weight: bold;
    }

    .btn {
        margin-right: 10px;
    }

    .text-danger {
        color: #dc3545;
    }
</style>

<h2 style="color: black;">Add Diagnosis for @Model.CowName</h2>

<div class="form-container">
    <div class="card">
        <div class="card-header">
            Diagnosis Information
        </div>
        <div class="card-body">
            <a asp-action="Diag" asp-route-id="@Model.CowId" class="btn btn-secondary">Back to diagnosis</a>

            @if (User.IsInRole("Admin"))
            {
                    <form asp-action="DiagAdd" asp-controller="Cow" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="CowId" value="@Model.CowId" />

                        <div class="form-group">
                            <label asp-for="SelectedDiseaseId" class="control-label">Disease</label>
                                <button asp-controller="Disease" asp-action="DiseaseCreate" class="btn btn-primary">Add disease</button>
                            <select asp-for="SelectedDiseaseId" class="form-control" asp-items="@(new SelectList(Model.Diseases, "Id", "Name"))">
                                <option value="">Select Disease</option>
                            </select>
                            <span asp-validation-for="SelectedDiseaseId" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Comment" class="control-label">Comment</label>
                            <textarea asp-for="Comment" class="form-control"></textarea>
                            <span asp-validation-for="Comment" class="text-danger"></span>
                        </div>

                        <div class="card-footer">
                            <input type="submit" value="Add Diagnosis" class="btn btn-primary" />
                        </div>
                    </form>
            }
            else
            {
                    <p class="text-center text-danger">
                        You don't have access to Add Diagnosis ;(
                    </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
