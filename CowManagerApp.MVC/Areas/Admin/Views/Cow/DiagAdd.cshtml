<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.CowDiagAdd

<h2>Add Diagnosis for @Model.CowName</h2>
<h2>@Model.CowId</h2>
<a asp-action="Diag" asp-route-id="@Model.CowId">Back to diagnosis</a>
@if (User.IsInRole("Admin"))
{
    
<form asp-action="DiagAdd" asp-controller="Cow" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="CowId" value="@Model.CowId" />

    <div class="form-group">
        <label asp-for="SelectedDiseaseId" class="control-label">Disease</label>
        <a asp-controller="Disease" asp-action="DiseaseCreate">Add disease</a>
        <select asp-for="SelectedDiseaseId" class="form-control" asp-items="@(new SelectList(Model.Diseases, "Id", "Name"))">
            <option value="">Select Disease</option>
        </select>
        <span asp-validation-for="SelectedDiseaseId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Comment" class="control-label">Comment</label>
        <textarea asp-for="Comment" class="form-control"></textarea>
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>
@* 
    <button type="submit" class="btn btn-primary">Add Diagnosis</button> *@
    <div class="form-group">
        <input type="submit" value="Add diagnosy" class="btn btn-primary" />
    </div>
</form>
}else
{
    <p style="text-align: center; font-size: 18px;"> You don't have access</P>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
