<link rel="stylesheet" href="~/css/Delete.css" asp-append-version="true" />
@model CowManager.Models.Models.Cow

@{
    ViewData["Title"] = "Delete";
}
@if (User.IsInRole("Admin")){
<div class="container">
    <h2>Delete</h2>
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Id</dt>
                    <dd class="col-sm-8">@Model.Cowid</dd>

                <dt class="col-sm-4">Herd</dt>
                <dd class="col-sm-8">@Model.Nameherd</dd>

                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

            </dl>
        </div>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="previousUrl" value="@ViewBag.PreviousUrl" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a href="@ViewBag.PreviousUrl" class="btn btn-primary">Return</a>
    </form>
    </div>
}
else
{
    <p style="text-align: center; font-size: 18px;">
        You don't have access to Delate ;(
    </p>
}