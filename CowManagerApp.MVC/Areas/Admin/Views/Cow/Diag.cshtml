<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.CowDiag

<style>
    .card-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        background-color: #f8f9fa;
    }

    .card {
        margin-bottom: 20px;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #007bff;
        color: white;
        font-weight: bold;
        padding: 15px;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .card-body {
        padding: 20px;
    }

    .card-footer {
        background-color: #f8f9fa;
        padding: 10px;
        text-align: right;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    .btn {
        margin-right: 10px;
    }

    .text-danger {
        color: #dc3545;
    }

    
</style>

<h2 style="color: black;">@Model.Cow.Name</h2>
<p style="color: black;">Comments: @Model.Cow.Comment</p>

<div class="card-container">
    <div class="card">
        <div class="card-header">
            Diagnoses
        </div>
        <div class="card-body">
            @if (User.IsInRole("Admin"))
            {
                    <div>
                    @Html.ActionLink("Add Diagnosis", "DiagAdd", "Cow", new { id = Model.Cow.Id }, new { @class = "btn btn-primary" })
                    </div>
                        <button asp-action="Documentation" asp-controller="Cow" asp-route-id="@Model.Cow.Id" class="btn btn-primary">Documentation</button>

                @if (Model.Diagnoses.Any())
                {
                            <ul>
                        @foreach (var diagnosis in Model.Diagnoses)
                        {
                                        <li>
                                            <strong>Disease:</strong> @diagnosis.NameOfDisease
                                            <br />
                                            <strong>Comment:</strong> @diagnosis.Comment
                                            <br />
                                            <a asp-action="TreatForDiag" asp-controller="Cow" asp-route-idd="@diagnosis.Id" asp-route-idk="@Model.Cow.Id" class="btn btn-warning btn-sm">Treatment</a>
                                            <a asp-action="DiseaseDetails" asp-controller="Disease" asp-route-id="@diagnosis.Iddisease" class="btn btn-info btn-sm">Details</a>
                                            <a asp-action="DiagRemove" asp-route-id="@diagnosis.Id" class="btn btn-danger btn-sm">Delete</a>
                                            <a asp-action="DiagEdit" asp-route-id="@diagnosis.Id" class="btn btn-secondary btn-sm">Edit</a>
                                        </li>
                        }
                            </ul>
                }
                else
                {
                            <p>No diagnoses found for this cow.</p>
                }
            }
            else
            {
                @if (Model.Diagnoses.Any())
                {
                            <ul>
                        @foreach (var diagnosis in Model.Diagnoses)
                        {
                                        <li>
                                            <strong>Disease:</strong> @diagnosis.NameOfDisease
                                            <br />
                                            <strong>Comment:</strong> @diagnosis.Comment
                                            <br />
                                            <a asp-action="TreatForDiag" asp-controller="Cow" asp-route-idd="@diagnosis.Id" asp-route-idk="@Model.Cow.Id" class="btn btn-warning btn-sm">Treatment</a>
                                            <a asp-action="DiseaseDetails" asp-controller="Disease" asp-route-id="@diagnosis.Iddisease" class="btn btn-info btn-sm">Details</a>
                                        </li>
                        }
                            </ul>
                }
                else
                {
                            <p>No diagnoses found for this cow.</p>
                }
            }

            <div class="card-footer">
                <a href="@ViewBag.PreviousUrl" class="btn btn-primary">Return</a>
            </div>
        </div>
    </div>
</div>