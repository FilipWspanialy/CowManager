<link rel="stylesheet" href="~/css/List.css" asp-append-version="true" />
@model IEnumerable<CowManager.Models.Models.Cow>
@{
    ViewData["Title"] = "List";
}
<h1>@ViewData["Title"]</h1>



<p>
    <a asp-action="Create">Create New</a>
</p>


<table class="table">
        <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Name
            </th>
            <th>
                Idherd
            </th>
            

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Id
                </td>
                <td>
                    @item.Name
                </td>
                <td>
                    @item.Idherd
                </td>
                




                <td>
                    <a asp-action="Diag" asp-route-id="@item.Id">Diagnosis</a> |
                    <a asp-action="Treat" asp-route-id="@item.Id">Treatment</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>

            </tr>

        }
     </tbody>
</table>

