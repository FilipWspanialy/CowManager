<link rel="stylesheet" href="~/css/List.css" asp-append-version="true" />
@model IEnumerable<CowManager.Models.Models.Cow>
@{
    ViewData["Title"] = "List";
}

<h1 style="color: black;"> @ViewData["Title"]</h1>

<form asp-action="Index" method="get">
    <p style="color: black;">
        Search by name: <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" />
        <input type="submit" value="Search" class="btn btn-primary" />
    </p>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>


<table id="cow-list-table" style="background-color: #f0f0f0; color: #000; border: 1px solid #000;" class="table custom-table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Herd</th>
            <th>Birth date</th>
            <th>Death date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.Cowid</td>
                    <td>
                    @if (item.DeathDate.HasValue)
                    {
                                <span class="strikethrough">@item.Name</span>
                    }
                    else
                    {
                                <span>@item.Name</span>
                    }
                    </td>
                    <td>@item.Nameherd</td>
                    <td>@(item.BirthDate.HasValue ? item.BirthDate.Value.ToString("dd-MM-yyyy") : "")</td>
                    <td>@(item.DeathDate.HasValue ? item.DeathDate.Value.ToString("dd-MM-yyyy") : "")</td>
                    <td>
                        <a asp-action="Diag" asp-route-id="@item.Id" class="btn btn-info btn-sm">Diagnosis</a>
                        <a asp-action="Treat" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Treatment</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success btn-sm">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
        }
    </tbody>
</table>


<style>
    #cow-list-table {
        background-color: #f0f0f0 !important;
        color: #000 !important;
    }

    #cow-list-table th, #cow-list-table td {
        border: 1px solid #000 !important;
    }

    .strikethrough {
        text-decoration: line-through;
        color: red;
    }

    .custom-table {
        --bs-table-color: #000 !important;
        --bs-table-bg: #f0f0f0 !important;
        --bs-table-border-color: #000 !important;
        --bs-table-striped-bg: transparent !important;
        --bs-table-hover-bg: transparent !important;
        border-width: 3px !important;
        border-radius: 10px !important;
        border-style: solid !important;
    }

    .custom-table th, .custom-table td {
        color: #000 !important;
        background-color: #f0f0f0 !important;
        border: 1px solid #000 !important;
        border-width: 2px !important;
    }

    .btn {
        margin-right: 5px;
    }
</style>