<link rel="stylesheet" href="~/css/Create.css" asp-append-version="true" />
@model CowManager.Models.Models.Cow

@{
    ViewData["Title"] = "Details";
}

<style>
    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        background-color: #f0f0f0;
        padding: 20px;
        border-radius: 10px;
        color: #000;
    }

    .details-grid-item {
        background-color: #ffffff;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);
    }

    .details-grid-item dt {
        font-weight: bold;
    }

    .form-group {
        margin-top: 20px;
    }

    .btn {
        margin-right: 10px;
    }
</style>

<div class="container">
    <h2 style="color: black;">Details</h2>
    <div class="details-grid">
        <div class="details-grid-item">
            <dl>
                <dt>Id</dt>
                <dd>@Model.Cowid</dd>
            </dl>
        </div>

        <div class="details-grid-item">
            <dl>
                <dt>Herd</dt>
                <dd>@Model.Nameherd</dd>
            </dl>
        </div>

        <div class="details-grid-item">
            <dl>
                <dt>Name</dt>
                <dd>@Model.Name</dd>
            </dl>
        </div>

        <div class="details-grid-item">
            <dl>
                <dt>Comment</dt>
                <dd>@Model.Comment</dd>
            </dl>
        </div>

        <div class="details-grid-item">
            <dl>
                <dt>Owner</dt>
                <dd>@ViewBag.UserName</dd>
            </dl>
        </div>

        <div class="details-grid-item">
            <dl>
                <dt>Birth Date</dt>
                <dd>@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "N/A")</dd>
            </dl>
        </div>

        <div class="details-grid-item">
            <dl>
                <dt>Death Date</dt>
                <dd>@(Model.DeathDate.HasValue ? Model.DeathDate.Value.ToString("yyyy-MM-dd") : "N/A")</dd>
            </dl>
        </div>
    </div>

    <div class="form-group">
        <a href="@ViewBag.PreviousUrl" class="btn btn-primary">Return</a>
    </div>
</div>