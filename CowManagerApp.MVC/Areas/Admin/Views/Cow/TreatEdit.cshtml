<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.Treatment

@{
    ViewData["Title"] = "Edit";
}

<style>
    .form-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000; 
    }

    .form-group label {
        font-weight: bold;
    }

    .btn {
        margin-right: 10px;
    }

    .text-danger {
        color: #dc3545;
    }

    .no-access {
        text-align: center;
        font-size: 18px;
        color: #dc3545;
    }

    h1, h4 {
        color: #000; 
    }
</style>

<h1>Edit</h1>
<h4>Cow</h4>
<hr />

@if (User.IsInRole("Admin"))
{
        <div class="form-container">
            <form asp-action="TreatEdit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Idcow" />
                <input type="hidden" asp-for="Idmedicine" />
                <input type="hidden" asp-for="NameOfMedicine" />

                <div class="form-group">
                    <label asp-for="Comment" class="control-label">Comment</label>
                    <input asp-for="Comment" class="form-control" />
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a asp-action="Treat" asp-route-id="@Model.Idcow" class="btn btn-secondary">Return</a>
                </div>
            </form>
        </div>
}
else
{
        <p class="no-access">You don't have access to Edit ;(</p>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}