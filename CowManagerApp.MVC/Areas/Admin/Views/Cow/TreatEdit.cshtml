<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.Treatment

@{

    ViewData["Title"] = "Edit";

}

<h1>Edit</h1>

<hr />
@if (User.IsInRole("Admin"))

{

    
    <div class="row">
        <div class="col-md-4">
            <form asp-action="TreatEdit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Idcow" />
                <input type="hidden" asp-for="Idmedicine" />
                <input type="hidden" asp-for="NameOfMedicine" />

                <div class="form-group">
                    <label asp-for="Comment" class="control-label"></label>
                    <input asp-for="Comment" class="form-control" />
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a asp-action="Treat" asp-route-id="@Model.Idcow">Return</a>
                </div>
            </form>
        </div>
    </div>

}
else
{
    <p style="text-align: center; font-size: 18px;">
        You don't have access to Create ;(
    </p>
}



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
