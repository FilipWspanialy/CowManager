<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.CowTreat

<style>
    .form-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card {
        margin-bottom: 20px;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #007bff;
        color: white;
        font-weight: bold;
        padding: 15px;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .card-body {
        padding: 20px;
    }

    .card-footer {
        background-color: #f8f9fa;
        padding: 10px;
        text-align: right;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }

  

    .text-danger {
        color: #dc3545;
    }

    .btn {
        margin-right: 10px;
    }

    .no-data {
        font-style: italic;
        color: #888;
    }
</style>

<div class="form-container">
    <div class="card">
        <div class="card-header">
            @Model.Cow.Name
        </div>
        <div class="card-body">
            <p>@Model.Cow.Cowid</p>
            <a asp-action="Diag" asp-route-id="@Model.Cow.Id" class="btn btn-secondary">Back to diagnosis</a>
            <a asp-action="Documentation" asp-controller="Cow" asp-route-id="@Model.Cow.Id" class="btn btn-secondary">Documentation</a>
            <h2>@ViewBag.Disease</h2>

            @if (User.IsInRole("Admin"))
            {
                    <h3>Treatment</h3>
                    <a asp-action="TreatForDiagAdd" asp-controller="Cow" asp-route-idd="@ViewBag.idd" asp-route-idk="@Model.Cow.Id" class="btn btn-primary">Add medicine</a>

                @if (Model.Treatments.Any())
                {
                            <ul>
                        @foreach (var treats in Model.Treatments)
                        {
                                        <li>
                                            <strong>Medicine:</strong> @treats.NameOfMedicine
                                            <br />
                                            <strong>Comment:</strong> @treats.Comment
                                            <br />
                                            <a asp-action="MedicineDetails" asp-controller="Medicine" asp-route-id="@treats.Idmedicine" class="btn btn-link">Details</a>
                                            <a asp-action="TreatRemove" asp-route-id="@treats.Id" class="btn btn-danger">Delete</a>
                                            <a asp-action="TreatEdit" asp-route-id="@treats.Id" class="btn btn-primary">Edit</a>
                                        </li>
                        }
                            </ul>
                }
                else
                {
                            <p class="no-data">No treatments found for this cow.</p>
                }
            }
            else
            {
                    <h3>Treatment</h3>
                @if (Model.Treatments.Any())
                {
                            <ul>
                        @foreach (var treats in Model.Treatments)
                        {
                                        <li>
                                            <strong>Medicine:</strong> @treats.NameOfMedicine
                                            <br />
                                            <strong>Comment:</strong> @treats.Comment
                                            <br />
                                            <a asp-action="MedicineDetails" asp-controller="Medicine" asp-route-id="@treats.Idmedicine" class="btn btn-link">Details</a>
                                        </li>
                        }
                            </ul>
                }
                else
                {
                            <p class="no-data">No treatments found for this cow.</p>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}