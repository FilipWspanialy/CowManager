<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.Diagnosis

@{
    ViewData["Title"] = "Edit";
}

<h2 style="color: black;">Edit Diagnosis for @Model.NameOfDisease</h2>

<div class="form-container">
    <div class="card">
        <div class="card-header">
            Edit Diagnosis Information
        </div>
        <div class="card-body">
            <a asp-action="Diag" asp-route-id="@Model.Idcow" class="btn btn-secondary">Back to diagnosis</a>

            <form asp-action="DiagEdit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Idcow" />
                <input type="hidden" asp-for="Iddisease" />
                <input type="hidden" asp-for="NameOfDisease" />

                <div class="form-group">
                    <label asp-for="Comment" class="control-label">Comment</label>
                    <textarea asp-for="Comment" class="form-control"></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <div class="card-footer">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a asp-action="Diag" asp-route-id="@Model.Idcow">Return</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .form-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card {
        margin-bottom: 20px;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background-color: #007bff;
        color: white;
        font-weight: bold;
        padding: 15px;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .card-body {
        padding: 20px;
    }

    .card-footer {
        background-color: #f8f9fa;
        padding: 10px;
        text-align: right;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    .form-group label {
        font-weight: bold;
    }

    .form-control {
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 10px;
        color: #333;
        width: 100%;
        box-sizing: border-box;
    }

    .btn-primary {
        background-color: #007bff;
        padding: 10px 15px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        color: white;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        padding: 10px 15px;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        cursor: pointer;
    }

    .text-danger {
        color: #dc3545;
    }
</style>