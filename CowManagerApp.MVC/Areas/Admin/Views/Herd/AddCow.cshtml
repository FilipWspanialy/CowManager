@model CowManager.Models.Models.Cow

<h1>Create Cow for Herd @ViewBag.HerdId</h1>

<a asp-controller="Herd" asp-action="Index" class="nav-link text-dark">Go to list of herds</a>

<form asp-action="AddCow" method="post">
    <input type="hidden" asp-for="Idherd" />
    <input type="hidden" name="previousUrl" value="@ViewBag.PreviousUrl" />

    <div class="form-group">
        <label asp-for="Cowid" class="control-label"></label>
        <input asp-for="Cowid" class="form-control" />
        <span asp-validation-for="Cowid" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Comment" class="control-label"></label>
        <input asp-for="Comment" class="form-control" />
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="BirthDate">Birth date</label>
        <input type="date" class="form-control" asp-for="BirthDate" />
    </div>

    <div class="form-group">
        <label for="DeathDate">Death date</label>
        <input type="date" class="form-control" asp-for="DeathDate" />
    </div>

    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a href="@ViewBag.PreviousUrl" class="btn btn-secondary">Return</a>
    </div>
</form>

@section Scripts {
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
