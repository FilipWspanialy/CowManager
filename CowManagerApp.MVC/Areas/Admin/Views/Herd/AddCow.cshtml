<link rel="stylesheet" href="~/css/Herd.css" asp-append-version="true" />
@model CowManager.Models.Models.Cow

@{
    ViewData["Title"] = "Create Cow";
}

<style>
    .form-container {
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000; 
    }

    h1 {
        color: #000; 
    }

    .form-group label {
        font-weight: bold;
    }

    .text-danger {
        color: #dc3545;
    }

    .btn-primary {
        margin-right: 10px;
    }

    .return-btn {
        margin-top: 20px;
    }
</style>

<div class="form-container">
    <h1>Create Cow for Herd @ViewBag.HerdId</h1>
    <hr />

    <a class="nav-link text-dark" asp-area="" asp-controller="Herd" asp-action="Index">Herds</a>

    <form asp-action="AddCow" method="post">
        <input type="hidden" asp-for="Idherd" />
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" name="previousUrl" value="@ViewBag.PreviousUrl" />

        <div class="form-group">
            <label asp-for="Cowid" class="control-label">Cow ID</label>
            <input asp-for="Cowid" class="form-control" />
            <span asp-validation-for="Cowid" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Name" class="control-label">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Comment" class="control-label">Comment</label>
            <input asp-for="Comment" class="form-control" />
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label for="BirthDate">Birth Date</label>
            <input type="date" class="form-control" id="BirthDate" name="BirthDate" value="@(Model != null && Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="form-group">
            <label for="DeathDate">Death Date</label>
            <input type="date" class="form-control" id="DeathDate" name="DeathDate" value="@(Model != null && Model.DeathDate.HasValue ? Model.DeathDate.Value.ToString("yyyy-MM-dd") : "")" />
        </div>

        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary" />
            <a href="@ViewBag.PreviousUrl" class="btn btn-secondary">Return</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}