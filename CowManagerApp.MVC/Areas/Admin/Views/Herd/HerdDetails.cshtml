<link rel="stylesheet" href="~/css/Herd.css" asp-append-version="true" />
@model CowManager.Models.Models.Herd

<h1>Cows in herd: @Model.Id</h1>
<p>Total Cows: @Model.AmountOfCows</p>


<a asp-action="Index" asp-controller="Herd" >Back to Herds</a>|
<a asp-action="HerdEdit" asp-route-id="@Model.Id">Edit</a> |
<a asp-action="HerdDelete" asp-route-id="@Model.Id">Delete</a> |
<a asp-action="AddCow" asp-route-idh="@Model.Id" >Add Cow</a>



<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Name
            </th>
            <th>
                Comment
            </th>
            <th>
                Birth date
            </th>
            <th>
                Death date
            </th>


        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Cows)
        {
            <tr>
                <td>
                    @item.Id
                </td>
                <td>
                @if (item.DeathDate.HasValue)
                {
                    <span class="strikethrough">@item.Name</span>
                }
                else
                {
                    <span>@item.Name</span>
                }
                </td>
                <td>
                    @item.Comment
                </td>
                <td>
                    @item.BirthDate
                </td>
                <td>
                    @item.DeathDate
                </td>

                <td>
                    <a asp-action="Diag" asp-controller="Cow" asp-route-id="@item.Id">Diagnosis</a> |
                    <a asp-action="Treat" asp-controller="Cow" asp-route-id="@item.Id">Treatment</a> |
                    <a asp-action="Edit" asp-controller="Cow" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-controller="Cow" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-controller="Cow"  asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>

        }
    </tbody>
</table>