<link rel="stylesheet" href="~/css/Herd.css" asp-append-version="true" />
@model CowManager.Models.Models.Herd

@{
    ViewData["Title"] = $"Herd Details - {Model.Id}";
}

<style>
    .page-container {
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000; /* Black text */
    }

    h1 {
        color: #000; /* Black text for headings */
    }

    p {
        color: #000; /* Black text for paragraphs */
    }

    .table {
        margin-top: 20px;
    }

    .table th, .table td {
        text-align: center;
    }

    .table th {
        background-color: #343a40; /* Dark gray background for headers */
        color: #ffffff; /* White text */
        font-weight: bold;
    }

    .table td a {
        margin-right: 10px;
    }

    .btn {
        margin: 5px;
    }
</style>

<div class="page-container">
    <h1>Cows in herd: @Model.Id</h1>
    <p>Total Cows: @Model.AmountOfCows</p>

    <div>
        <input type="hidden" name="previousUrl" value="@ViewBag.PreviousUrl" />
        <a class="btn btn-primary" href="@ViewBag.PreviousUrl">Return</a>
        <a class="btn btn-warning" asp-action="HerdEdit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-danger" asp-action="HerdDelete" asp-route-id="@Model.Id">Delete</a>
        <a class="btn btn-success" asp-action="AddCow" asp-route-idh="@Model.Id">Add Cow</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Comment</th>
                <th>
                    Birth date
                </th>
                <th>
                    Death date
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Cows)
            {
                    <tr>
                        <td>@item.Id</td>
                    <td>
                        @if (item.DeathDate.HasValue)
                        {
                            <span class="strikethrough">@item.Name</span>
                        }
                        else
                        {
                            <span>@item.Name</span>
                        }
                    </td>
                        <td>@item.Comment</td>
                    <td>
                        @item.BirthDate
                    </td>
                    <td>
                        @item.DeathDate
                    </td>
                        <td>
                            <a class="btn btn-info" asp-action="Diag" asp-controller="Cow" asp-route-id="@item.Id">Diagnosis</a>
                            <a class="btn btn-info" asp-action="Treat" asp-controller="Cow" asp-route-id="@item.Id">Treatment</a>
                            <a class="btn btn-warning" asp-action="Edit" asp-controller="Cow" asp-route-id="@item.Id">Edit</a>
                            <a class="btn btn-primary" asp-action="Details" asp-controller="Cow" asp-route-id="@item.Id">Details</a>
                            <a class="btn btn-danger" asp-action="Delete" asp-controller="Cow" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
            }
        </tbody>
    </table>
</div>