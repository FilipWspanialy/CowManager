<link rel="stylesheet" href="~/css/Herd.css" asp-append-version="true" />
@model CowManager.Models.Models.Herd

@{
    ViewData["Title"] = "Delete";
}

<div class="container">
    <h2>Delete</h2>
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Id</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Comment</dt>
                <dd class="col-sm-8">@Model.Comment</dd>
            </dl>
        </div>
    </div>
    <div class="form-group">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <input type="hidden" name="previousUrl" value="@ViewBag.PreviousUrl" />
            <a href="@ViewBag.PreviousUrl" class="btn btn-primary">Return</a>
        </form>
    </div>
</div>