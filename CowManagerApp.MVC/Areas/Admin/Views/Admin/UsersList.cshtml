@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

<h2>Lista użytkowników</h2>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Name</th>
            <th>Akcje</th> 
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>

                    <a href="@Url.Action("UserDetails", "Admin", new { id = user.Id })">@user.UserName</a>
                </td>
            </tr>
        }
    </tbody>
</table>
