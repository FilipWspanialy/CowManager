@model CowManager.Models.Models.UserDetailsViewModel

<h1>User Details: @Model.User.UserName</h1>
<p>
    <a asp-area="Admin" asp-controller="Admin" asp-action="UsersList">Back to List</a>
</p>
<h2>Herds</h2>
<p>
    <a asp-controller="Herd" asp-action="HerdCreate">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Comment</th>
            <th>Amount of cows</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Herd)
        {
            <tr>
                <td><a href="@Url.Action("HerdDetails", new { id = item.Id })">@item.Id</a></td>
                <td><a href="@Url.Action("HerdDetails", new { id = item.Id })">@item.Comment</a></td>
                <td>@item.AmountOfCows</td>
            <td>
                <a asp-controller="Herd" asp-action="AddCow" asp-route-idh="@item.Id">Add Cow</a>|
                <a asp-controller="Herd" asp-action="HerdEdit" asp-route-id="@item.Id">Edit</a> |
                <a asp-controller="Herd" asp-action="HerdDelete" asp-route-id="@item.Id">Delete</a>
            </td>
            </tr>
        }
    </tbody>
</table>

<h2>Cows</h2>

<p>
    <a asp-controller="Cow" asp-action="Create">Create New</a>
</p>
<form asp-action="Index" method="get">
    <p>
        Search by name: <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" />
        <input type="submit" value="Search" class="btn btn-primary" />
    </p>
</form>
@* <p>
    <a asp-controller="Cow" asp-action="Create" asp-route="@Model.User.Id">Create New</a>
</p> *@
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Comment</th>
            <th>Herd</th>
            <th>Birth date</th>
            <th>Death date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Cows)
        {
            <tr>
                <td>@item.Cowid</td>
                <td>
                    @if (item.DeathDate.HasValue)
                    {
                        <span class="strikethrough">@item.Name</span>
                    }
                    else
                    {
                        <span>@item.Name</span>
                    }
                </td>
                <td>@item.Comment</td>
                <td> @item.Nameherd</td>
                <td>@item.BirthDate</td>
                <td>@item.DeathDate</td>

            <td>
                <a asp-controller="Cow" asp-action="Diag" asp-route-id="@item.Id">Diagnosis</a> |
                <a asp-controller="Cow" asp-action="Treat" asp-route-id="@item.Id">Treatment</a> |
                <a asp-controller="Cow" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-controller="Cow" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-controller="Cow" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
            </tr>
        
        }
    </tbody>
</table>
