<link rel="stylesheet" href="~/css/Disease.css" asp-append-version="true" />
@model IEnumerable<CowManager.Models.Models.Disease>
@{
    ViewData["Title"] = "List";
}
<h1>@ViewData["Title"]</h1>
<a asp-action="DiseaseCreate">Create</a>

<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Name
            </th>
            

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Id
                </td>
                <td>
                    @item.Name
                </td>
                
                <td>
                    <a asp-action="DiseaseDetails" asp-route-id="@item.Id">Details</a>|
                    <a asp-action="DiseaseEdit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="DiseaseDelete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>

        }
    </tbody>
</table>
