<link rel="stylesheet" href="~/css/Disease.css" asp-append-version="true" />
@model CowManager.Models.Models.Disease

@{
    ViewData["Title"] = "Details";
}

<style>
    .details-container {
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000; 
    }

    dl {
        margin-bottom: 20px;
    }

    dt {
        font-weight: bold;
        color: #000; 
    }

    dd {
        color: #000; 
    }

    h2 {
        color: #000; 
    }

    .btn-primary {
        margin-top: 20px;
        margin-right: 10px;
    }

    a {
        color: #007bff;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    .edit-link {
        margin-top: 20px;
    }
</style>

<div class="details-container">
    <h2>Details</h2>
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Comment</dt>
                <dd class="col-sm-8">@Model.Comment</dd>
            </dl>
        </div>
    </div>

    <div class="edit-link">
        <a asp-action="DiseaseEdit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
    </div>

    <div class="form-group">
        <a href="@ViewBag.PreviousUrl" class="btn btn-primary">Return</a>
    </div>
</div>