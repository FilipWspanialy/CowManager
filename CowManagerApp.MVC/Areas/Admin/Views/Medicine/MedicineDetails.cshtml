<link rel="stylesheet" href="~/css/Medicine.css" asp-append-version="true" />
@model CowManager.Models.Models.Medicine

@{
    ViewData["Title"] = "Details";
}

<style>
    .form-container {
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000; /* Black text */
    }

    h2, dt {
        color: #000; /* Black text for headings and labels */
    }

    .form-group label {
        font-weight: bold;
    }

    .btn-primary {
        margin-top: 20px;
    }

    .row dt {
        font-weight: bold;
    }
</style>

<div class="form-container">
    <h2>Medicine Details</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Id</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Comment</dt>
                <dd class="col-sm-8">@Model.Comment</dd>
            </dl>
        </div>
    </div>
    <div>
        <a href="@Url.Action("MedicineEdit", new { id = @Model.Id })" class="btn btn-secondary">Edit</a>
    </div>
    <div class="form-group">
        <a href="@ViewBag.PreviousUrl" class="btn btn-primary">Return</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}