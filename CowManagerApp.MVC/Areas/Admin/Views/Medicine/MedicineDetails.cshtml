<link rel="stylesheet" href="~/css/Medicine.css" asp-append-version="true" />
@model CowManager.Models.Models.Medicine

@{
    ViewData["Title"] = "Details";
}


<div class="container">
    <h2>Details</h2>
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Id</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Comment</dt>
                <dd class="col-sm-8">@Model.Comment</dd>
            </dl>
        </div>
    </div>
    <div>
        <a asp-action="MedicineEdit" asp-route-id="@Model.Id">Edit</a>
    </div>
    <div class="form-group">
        <a href="@ViewBag.PreviousUrl" class="btn btn-primary">Return</a>
    </div>
</div>