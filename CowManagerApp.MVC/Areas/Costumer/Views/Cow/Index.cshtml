<link rel="stylesheet" href="~/css/Create.css" asp-append-version="true" />
@model IEnumerable<CowManager.Models.Models.Cow>
@{
    ViewData["Title"] = "List";
}

<style>
    .search-bar {
        display: flex;
        justify-content: flex-start;
        gap: 10px;
        margin-bottom: 20px;
    }

    .search-bar input[type="text"] {
        width: 250px;
        padding: 5px;
        border-radius: 5px;
        border: 1px solid #ccc;
    }

    .btn-primary {
        padding: 6px 12px;
        border-radius: 5px;
    }

    .action-links a {
        margin-right: 10px;
        text-decoration: none;
    }

    .strikethrough {
        text-decoration: line-through;
        color: #dc3545;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    table, th, td {
        border: 1px solid #ddd;
    }

    th, td {
        padding: 10px;
        text-align: left;
    }

    th {
        background-color: #007bff;
        color: white;
    }

    tr:nth-child(even) {
        background-color: #f8f9fa;
    }

    tr:hover {
        background-color: #f1f1f1;
    }
</style>
<style>
    .table {
        width: 100%;
        border-collapse: collapse;
        border: 2px solid #000; /* Pogrubione czarne obramowanie tabeli */
    }

    .table th, .table td {
        border: 2px solid #000; /* Pogrubione czarne obramowanie dla komórek */
        padding: 10px;
        text-align: left;
        background-color: #fff; /* Białe tło */
        color: #000; /* Czarny tekst */
    }

    .table th {
        background-color: #f0f0f0; /* Jasno szare tło dla nagłówków */
        font-weight: bold; /* Pogrubiona czcionka dla nagłówków */
    }

    .table tr:nth-child(even) {
        background-color: #f9f9f9; /* Bardzo delikatny szary dla co drugiego wiersza */
    }

    .table tr:hover {
        background-color: #e9e9e9; /* Kolor wiersza przy najechaniu */
    }
</style>
<h1 style="color: black;">@ViewData["Title"]</h1>

<form asp-action="Index" method="get">
    <div class="search-bar">
        <label for="searchString" style="color: black;">Search by name:</label>
        <input type="text" id="searchString" name="searchString" value="@ViewData["CurrentFilter"]" />
        <input type="submit" value="Search" class="btn btn-primary" />
    </div>
</form>



<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Herd Id</th>
            <th>User Id</th>
            <th>Birth Date</th>
            <th>Death Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.Cowid</td>
                    <td>
                    @if (item.DeathDate.HasValue)
                    {
                                <span class="strikethrough">@item.Name</span>
                    }
                    else
                    {
                                <span>@item.Name</span>
                    }
                    </td>
                    <td>@item.Idherd</td>
                    <td>@item.UserId</td>
                    <td>@item.BirthDate?.ToString("yyyy-MM-dd")</td>
                    <td>@item.DeathDate?.ToString("yyyy-MM-dd")</td>
                    <td class="action-links">
                            <a asp-action="Diag" class="btn btn-primary" asp-route-id="@item.Id">Diagnosis</a>
                            <a asp-action="Treat" class="btn btn-primary" asp-route-id="@item.Id">Treatment</a>
                        <a asp-action="Details" class="btn btn-primary" asp-route-id="@item.Id">Details</a>
                        
                    </td>
                </tr>
        }
    </tbody>
</table>