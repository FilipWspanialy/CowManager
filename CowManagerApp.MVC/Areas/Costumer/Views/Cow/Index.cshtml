@model IEnumerable<CowManager.Models.Models.Cow>
@{
    ViewData["Title"] = "List";
}
<h1>@ViewData["Title"]</h1>

<form asp-action="Index" method="get">
    <p>
        Search by name: <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" />
        <input type="submit" value="Search" class="btn btn-primary" />
    </p>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>


<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Name
            </th>
            <th>
                Herd
            </th>
            <th>
                Birth date
            </th>
            <th>
                Death date
            </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Cowid
                </td>
                <td>
                    @if (item.DeathDate.HasValue)
                    {
                        <span class="strikethrough">@item.Name</span>
                    }
                    else
                    {
                        <span>@item.Name</span>
                    }
                </td>
                <td>
                    @item.Nameherd
                </td>
                




                <td>
                    <a asp-action="Diag" asp-route-id="@item.Id">Diagnosis</a> |
                    <a asp-action="Treat" asp-route-id="@item.Id">Treatment</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>

            </tr>

        }
    </tbody>
</table>


