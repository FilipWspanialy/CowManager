<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.CowTreat

<h2>@Model.Cow.Name</h2>
<p>Comments: @Model.Cow.Comment</p>
<a asp-action="Diag" asp-route-id="@Model.Cow.Id">Back to diagnosis</a>
<h2>@ViewBag.Disease</h2>

    <h3>Treatment</h3>
<a asp-action="Documentation" asp-controller="Cow" asp-route-id="@Model.Cow.Id">Documentation</a>
    @if (Model.Treatments.Any())
    {
        <ul>
            @foreach (var treats in Model.Treatments)
            {
                <li>
                    Medicine: @treats.NameOfMedicine
                    <br />
                    Comment: @treats.Comment
                    <br />
                    <a asp-action="MedicineDetails" asp-controller="Medicine" asp-route-id="@treats.Idmedicine">Details</a>
                   
                </li>
            }
        </ul>
    }
    else
    {
        <p>No diagnoses found for this cow.</p>
    }
