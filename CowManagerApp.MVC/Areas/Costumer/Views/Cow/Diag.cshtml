<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.CowDiag

@{
    ViewData["Title"] = $"Cow Details - {Model.Cow.Name}";
}

<style>
    .page-container {
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000;
    }

    h2 {
        color: #000;
    }

    p {
        color: #000;
    }

    .btn {
        margin: 5px;
    }

  

   
</style>

<div class="page-container">
    <h2>@Model.Cow.Name</h2>
    <p>Comments: @Model.Cow.Comment</p>

    <h3>Diagnoses</h3>

   

    @if (Model.Diagnoses.Any())
    {
            <ul>
            @foreach (var diagnosis in Model.Diagnoses)
            {
                        <li>
                            <strong>Disease:</strong> @diagnosis.NameOfDisease
                            <br />
                            <strong>Comment:</strong> @diagnosis.Comment
                            <br />
                            <a class="btn btn-info" asp-action="TreatForDiag" asp-controller="Cow" asp-route-idd="@diagnosis.Id" asp-route-idk="@Model.Cow.Id">Treatment</a>
                            <a class="btn btn-info" asp-action="DiseaseDetails" asp-controller="Disease" asp-route-id="@diagnosis.Iddisease">Details</a>
                    @if (User.IsInRole("Costumer"))
                    {
                                    <a class="btn btn-warning" asp-action="DiagEdit" asp-route-id="@diagnosis.Id">Edit</a>
                                    <a class="btn btn-danger" asp-action="DiagRemove" asp-route-id="@diagnosis.Id">Delete</a>
                    }
                        </li>
            }
            </ul>
    }
    else
    {
            <p>No diagnoses found for this cow.</p>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>