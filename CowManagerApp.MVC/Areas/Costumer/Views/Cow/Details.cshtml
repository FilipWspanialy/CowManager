<link rel="stylesheet" href="~/css/Create.css" asp-append-version="true" />
@model CowManager.Models.Models.Cow

@{
    ViewData["Title"] = "Details";
}

<style>
    .page-container {
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000;
    }

    h2 {
        color: #000;
    }

    dl {
        margin-top: 20px;
    }

    dt {
        font-weight: bold;
        color: #343a40;
    }

    dd {
        background-color: #e9ecef;
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 10px;
    }

    .btn {
        margin: 5px;
    }
</style>

<div class="page-container">
    <h2>Details</h2>
    <div class="row">
        <div class="col-md-6">
            <dl>
                <dt>Id</dt>
                <dd>@Model.Cowid</dd>

                <dt>Name</dt>
                <dd>@Model.Name</dd>

                <dt>Comment</dt>
                <dd>@Model.Comment</dd>

                <dt>Herd</dt>
                <dd>@Model.Nameherd</dd>

                <dt>Birth Date</dt>
                <dd>
                    @(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "N/A")
                </dd>

                <dt>Death Date</dt>
                <dd>
                    @(Model.DeathDate.HasValue ? Model.DeathDate.Value.ToString("yyyy-MM-dd") : "N/A")
                </dd>
            </dl>
        </div>
    </div>
    <div>
        <a href="@ViewBag.PreviousUrl" class="btn btn-secondary">Return</a>
    </div>
</div>