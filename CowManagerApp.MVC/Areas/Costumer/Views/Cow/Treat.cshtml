<link rel="stylesheet" href="~/css/Diagnosis.css" asp-append-version="true" />
@model CowManager.Models.Models.CowTreat

@{
    ViewData["Title"] = $"Cow Details - {Model.Cow.Name}";
}

<style>
    .page-container {
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000;
    }

    h2 {
        color: #000;
    }

    p {
        color: #000;
    }

    .btn {
        margin: 5px;
    }

</style>

<div class="page-container">
    <h2>@Model.Cow.Name</h2>
    <p>@Model.Cow.Cowid</p>

    <h3>Treatments</h3>


    <a asp-action="Documentation" asp-controller="Cow" asp-route-id="@Model.Cow.Id" class="btn btn-secondary">Documentation</a>
    @if (Model.Treatments.Any())
    {
        <ul>
            @foreach (var diagnosis in Model.Treatments)
            {
                <li>
                    <strong>Medicine:</strong> @diagnosis.NameOfMedicine
                    <br />
                    <strong>Comment:</strong> @diagnosis.Comment
                    <br />
                    <strong>Date of entry:</strong> @diagnosis.CreateTime
                    <br />
                    <a class="btn btn-info" asp-action="MedicineDetails" asp-controller="Medicine" asp-route-id="@diagnosis.Idmedicine">Details</a>
                </li>
            }
        </ul>
    }
    else
    {
        <p>No medicines found for this cow.</p>
    }
    <a href="@ViewBag.PreviousUrl" class="btn btn-secondary">Return</a>
</div>