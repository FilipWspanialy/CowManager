<link rel="stylesheet" href="~/css/Herd.css" asp-append-version="true" />
@model CowManager.Models.Models.Herd

@{
    ViewData["Title"] = "Create Herd";
}

<style>
    .form-container {
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000; /* Black text */
    }

    h1, h4 {
        color: #000; /* Black text for headings */
    }

    .form-group label {
        font-weight: bold;
    }

    .text-danger {
        color: #dc3545;
    }

    .btn-primary {
        margin-right: 10px;
    }

    .return-btn {
        margin-top: 20px;
    }
</style>

<div class="form-container">
    <h1>Create Herd</h1>
    <h4>Herd Details</h4>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="HerdCreate" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" name="previousUrl" value="@ViewBag.PreviousUrl" />

                <div class="form-group">
                    <label asp-for="Comment" class="control-label">Comment</label>
                    <input asp-for="Comment" class="form-control" />
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="UserId" class="control-label">Assign to User</label>
                    <select asp-for="UserId" class="form-control" asp-items="ViewBag.Users"></select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div class="return-btn">
        <a href="@ViewBag.PreviousUrl" class="btn btn-secondary">Return</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}