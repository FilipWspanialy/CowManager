<link rel="stylesheet" href="~/css/Herd.css" asp-append-version="true" />
@model CowManager.Models.Models.Herd

@{
    ViewData["Title"] = "Delete";
}

<style>
    .form-container {
        background-color: #f8f9fa;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        color: #000; /* Black text */
    }

    h2 {
        color: #000; /* Black text for headings */
    }

    .row dt {
        font-weight: bold;
    }

    .btn-danger {
        margin-right: 10px;
    }

    .return-btn {
        margin-top: 20px;
    }
</style>

<div class="form-container">
    <h2>Delete Herd</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Id</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Comment</dt>
                <dd class="col-sm-8">@Model.Comment</dd>
            </dl>
        </div>
    </div>
    <div class="form-group">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="previousUrl" value="@ViewBag.PreviousUrl" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a href="@ViewBag.PreviousUrl" class="btn btn-secondary return-btn">Return</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}